        p = self.pal
        # Filas alternas en las tablas
        for t in (self.tree, self.cmp_tree):
            t.tag_configure("odd", background=p["row_alt"])
        # Fondo de los lienzos de matplotlib
        for cv in (self.fig_canvas, self.cv_cmp, self.cv_trj):
            cv.get_tk_widget().configure(bg=p["bg"])
        # Lista desplegable de los Combobox (no la controla ttk)
        for w in self._walk(self):
            if isinstance(w, ttk.Combobox):
                try:
                    pop = self.tk.call("ttk::combobox::PopdownWindow", str(w))
                    self.tk.call(f"{pop}.f.l", "configure",
                                 "-background", p["field"], "-foreground", p["fg"],
                                 "-selectbackground", p["accent"],
                                 "-selectforeground", p["accent_fg"],
                                 "-borderwidth", 0, "-highlightthickness", 0)
                except tk.TclError:
                    pass

