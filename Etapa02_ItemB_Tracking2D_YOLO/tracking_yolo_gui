def side(p, a, b):
    """Producto cruz: signo = lado de la recta AB en que está el punto p."""
    return (b[0] - a[0]) * (p[1] - a[1]) - (b[1] - a[1]) * (p[0] - a[0])


def crossed_line(p_prev, p_curr, a, b):
    """+1 si cruzó el segmento AB del lado (-) al (+), -1 en sentido contrario, 0 si no cruzó."""
    d1, d2 = side(p_prev, a, b), side(p_curr, a, b)
    d3, d4 = side(a, p_prev, p_curr), side(b, p_prev, p_curr)
    if d1 * d2 < 0 and d3 * d4 < 0:
        return 1 if d1 < 0 else -1
    return 0


def color_for_id(track_id):
    rng = np.random.default_rng(int(track_id) * 9973 + 7)
    return tuple(int(c) for c in rng.integers(60, 255, 3))  # BGR


def safe_name(text):
    return re.sub(r"[^A-Za-z0-9_.-]+", "_", text).strip("_")


def obb_classes_from_gui(classes, names):
    """
    Traduce las clases COCO elegidas en la GUI a ids de clase de un modelo OBB (DOTA).
    None = todas las clases. Devuelve [] si ninguna clase elegida tiene equivalente.
    """
    if classes is None:
        return None
    wanted = {n for c in classes for n in COCO_TO_OBB_NAMES.get(c, ())}
    return sorted(i for i, n in names.items() if n in wanted)


def extract_detections(det, is_obb):
    """
    Unifica cajas normales (Boxes) y cajas orientadas (OBB) de Ultralytics.
    Devuelve: ids, clases, confianzas, centros (N,2) y polígonos (N,4,2).
    """
    ids = det.id.int().cpu().tolist()
    clss = det.cls.int().cpu().tolist()
    confs = det.conf.cpu().tolist()
    if is_obb:
        centers = det.xywhr[:, :2].cpu().numpy()      # cx, cy de la caja rotada
        polys = det.xyxyxyxy.cpu().numpy()            # 4 esquinas de la caja rotada
    else:
        xyxy = det.xyxy.cpu().numpy()
        centers = np.stack([(xyxy[:, 0] + xyxy[:, 2]) / 2,
                            (xyxy[:, 1] + xyxy[:, 3]) / 2], axis=1)
        polys = np.stack([xyxy[:, [0, 1]], xyxy[:, [2, 1]],
                          xyxy[:, [2, 3]], xyxy[:, [0, 3]]], axis=1)
    return ids, clss, confs, centers, polys


